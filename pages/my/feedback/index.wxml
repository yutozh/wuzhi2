<t-toast id="t-toast" />

<view class="feedback-page">
  <view class="page-header">
    <text class="header-title">意见反馈</text>
    <text class="header-subtitle">您的反馈是我们进步的动力</text>
  </view>

  <view class="page-content">
    <!-- 反馈分类 -->
    <view class="form-section">
      <text class="form-label">反馈类型 <text class="required">*</text></text>
      <view class="category-chips">
        <view
          wx:for="{{categories}}"
          wx:key="value"
          class="chip {{selectedCategory === item.value ? 'chip-active' : ''}}"
          bindtap="onSelectCategory"
          data-value="{{item.value}}"
        >
          <text>{{item.label}}</text>
        </view>
      </view>
    </view>

    <!-- 反馈内容 -->
    <view class="form-section">
      <text class="form-label">反馈内容 <text class="required">*</text></text>
      <view class="textarea-wrapper">
        <t-textarea
          value="{{content}}"
          placeholder="请详细描述您的问题或建议，有助于我们更快改进..."
          maxlength="500"
          indicator
          bind:change="onContentChange"
        />
      </view>
    </view>

    <!-- 联系邮箱 -->
    <view class="form-section">
      <text class="form-label">联系邮箱 <text class="optional">（选填）</text></text>
      <view class="input-wrapper">
        <input
          class="text-input"
          value="{{email}}"
          placeholder="填写邮箱以便我们回复您"
          type="text"
          bindinput="onEmailInput"
        />
      </view>
    </view>

    <!-- 验证码 -->
    <view class="form-section">
      <text class="form-label">验证码 <text class="required">*</text></text>
      <view class="captcha-row">
        <!-- 验证码图片区域 -->
        <view class="captcha-image-wrapper" bindtap="onRefreshCaptcha">
          <view
            wx:if="{{captchaImage && !captchaLoading}}"
            class="captcha-image"
            style="background-image: url('{{captchaImage}}')"
          />
          <view wx:elif="{{captchaLoading}}" class="captcha-placeholder">
            <text class="captcha-loading-text">加载中...</text>
          </view>
          <view wx:else class="captcha-placeholder">
            <text class="captcha-refresh-text">点击获取</text>
          </view>
        </view>
        <!-- 验证码输入框 -->
        <view class="input-wrapper captcha-input-wrapper">
          <input
            class="text-input"
            value="{{captchaInput}}"
            placeholder="请输入验证码"
            maxlength="6"
            bindinput="onCaptchaInput"
          />
        </view>
      </view>
    </view>

    <!-- 提交按钮 -->
    <button
      class="submit-btn {{submitting ? 'submit-btn-disabled' : ''}}"
      bindtap="onSubmit"
      disabled="{{submitting}}"
    >
      <text>{{submitting ? '提交中...' : '提交反馈'}}</text>
    </button>
  </view>
</view>
