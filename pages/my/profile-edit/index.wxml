<t-toast id="t-toast" />

<view class="profile-edit-page">
  <view class="edit-header">
    <!-- 使用微信官方头像选择器（open-type="chooseAvatar"），个人版小程序可用 -->
    <button class="avatar-section" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
      <image 
        class="avatar-preview" 
        src="{{userInfo.avatar || '/static/avatar1.png'}}" 
        mode="aspectFill"
      />
      <view class="avatar-edit-btn">
        <text class="material-icons">photo_camera</text>
      </view>
    </button>
    <view class="avatar-hint">点击更换头像</view>
  </view>

  <view class="edit-content">
    <view class="form-section">
      <view class="form-item">
        <view class="form-label">昵称</view>
        <!-- 使用 type="nickname" 可唤起微信昵称键盘，个人版小程序可用 -->
        <input 
          class="form-input" 
          type="nickname"
          value="{{userInfo.name}}" 
          placeholder="点击输入或使用微信昵称"
          bindinput="onNicknameInput"
        />
      </view>

      <view class="form-item">
        <view class="form-label">性别</view>
        <view class="gender-options">
          <view 
            wx:for="{{genderOptions}}" 
            wx:key="value"
            class="gender-option {{userInfo.gender === item.value ? 'gender-option-active' : ''}}"
            bindtap="onGenderSelect"
            data-value="{{item.value}}"
          >{{item.label}}</view>
        </view>
      </view>
    </view>

    <view class="action-section">
      <button 
        class="save-btn {{isSaving ? 'saving' : ''}}" 
        bindtap="onSave"
        disabled="{{isSaving}}"
      >
        <text class="material-icons btn-icon">check_circle</text>
        <text class="btn-text">{{isSaving ? '保存中...' : (isNewUser ? '完成登录' : '保存修改')}}</text>
      </button>
    </view>
  </view>
</view>
