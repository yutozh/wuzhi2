<t-toast id="t-toast" />

<view class="profile-page">
  <!-- 内容区域 -->
  <view class="profile-content">
    <!-- 个人信息卡片 -->
    <view class="info-card" bindtap="onEditProfile">
      <view class="info-card-content">
        <view class="info-icon-wrapper {{isLoggedIn ? 'has-avatar' : ''}}">
          <image 
            wx:if="{{isLoggedIn && userInfo.avatar}}"
            class="info-avatar" 
            src="{{userInfo.avatar}}" 
            mode="aspectFill"
          />
          <t-icon wx:else name="user" class="info-icon" />
        </view>
        <view class="info-text">
          <view class="info-name-row">
            <image 
              wx:if="{{vipConfig[userInfo.vipLevel].showBadge}}" 
              class="vip-badge-img" 
              src="{{vipConfig[userInfo.vipLevel].badge}}" 
              mode="aspectFit"
            />
            <text class="info-name" style="color: {{vipConfig[userInfo.vipLevel].color}}">{{userInfo.name}}</text>
          </view>
          <view class="info-id" wx:if="{{isLoggedIn && userInfo.id}}">ID: {{userInfo.id}}</view>
          <view class="info-hint" wx:if="{{!isLoggedIn}}">点击设置个人信息</view>
        </view>
      </view>
      <t-icon name="chevron-right" class="chevron-icon" />
    </view>

    <!-- 功能菜单卡片 -->
    <view class="menu-card">
      <view 
        wx:for="{{menuList}}" 
        wx:key="type"
        class="menu-item {{index < menuList.length - 1 ? 'menu-item-border' : ''}} {{item.highlight ? 'menu-item-highlight' : ''}}"
        bindtap="onMenuClick"
        data-type="{{item.type}}"
        data-url="{{item.url}}"
      >
        <view class="menu-item-content">
          <text class="material-icons menu-icon {{item.highlight ? 'menu-icon-highlight' : ''}}">{{item.icon}}</text>
          <text class="menu-label {{item.highlight ? 'menu-label-highlight' : ''}}">{{item.label}}</text>
        </view>
        <t-icon name="chevron-right" class="chevron-icon" />
      </view>
    </view>

    <!-- 统计卡片 -->
    <!-- <view class="stats-grid">
      <view class="stat-card stat-card-primary">
        <view class="stat-label">Total Value</view>
        <view class="stat-value">¥{{totalValueDisplay}}</view>
      </view>
      <view class="stat-card stat-card-success">
        <view class="stat-label">Total Items</view>
        <view class="stat-value">{{totalItems}}</view>
      </view>
    </view> -->

    <!-- 版本信息 -->
    <view class="version-info">
      <text class="version-text">Since 2026 • Made by Yuto</text>
    </view>
  </view>
</view>
