  </view>
</view>

<view class="home-release">
  <t-button theme="primary" size="large" icon="add" shape="round" bindtap="goRelease">
    发布
  </t-button>
</view>

<t-message id="t-message" />

<!-- 物品详情弹窗 -->
<view wx:if="{{showDetailModal}}" class="detail-modal-overlay" bindtap="closeDetailModal">
  <view class="detail-modal-container" catchtap="stopPropagation">
    <!-- 弹窗头部 -->
    <view class="detail-modal-header">
      <view class="detail-modal-title">物品详情</view>
      <view class="detail-modal-close" bindtap="closeDetailModal">
        <text class="close-icon">✕</text>
      </view>
    </view>

    <!-- 弹窗内容 -->
    <scroll-view class="detail-modal-content" scroll-y="true" bindtap="endEditUseTimes">
      <view wx:if="{{currentItemDetail}}" class="detail-content">
        
        <!-- 基本信息区域 -->
        <view class="detail-section">
          <view class="detail-section-title">基本信息</view>
          
          <!-- 物品图标和名称 -->
          <view class="detail-item detail-item-main">
            <view class="detail-item-icon">
              <image src="{{currentItemDetail.iconPath}}" class="detail-icon-image" mode="aspectFill" />
            </view>
            <view class="detail-item-info">
              <view class="detail-item-name">{{currentItemDetail.name}}</view>
              <view class="detail-item-brand">{{currentItemDetail.brand || '无品牌'}}</view>
            </view>
          </view>

          <!-- 分类和实体类型 -->
          <view class="detail-row">
            <view class="detail-item detail-item-half">
              <view class="detail-label">分类</view>
              <view class="detail-value">{{currentItemDetail.category}}</view>
            </view>
            <view class="detail-item detail-item-half">
              <view class="detail-label">类型</view>
              <view class="detail-value">{{currentItemDetail.entityTypeLabel}}</view>
            </view>
          </view>
        </view>

        <!-- 价格信息区域 -->
        <view class="detail-section">
          <view class="detail-section-title">价格信息</view>
          
          <view class="detail-row">
            <view class="detail-item detail-item-half">
              <view class="detail-label">购入价格</view>
              <view class="detail-value detail-value-price">¥{{currentItemDetail.purchasePriceDisplay}}</view>
            </view>
            <view class="detail-item detail-item-half">
              <view class="detail-label">数量</view>
              <view class="detail-value">{{currentItemDetail.quantity}}</view>
            </view>
          </view>
        </view>

        <!-- 日期信息区域 -->
        <view class="detail-section">
          <view class="detail-section-title">日期信息</view>
          
          <view class="detail-item">
            <view class="detail-label">购入日期</view>
            <view class="detail-value">{{currentItemDetail.purchaseDateFormatted}}</view>
          </view>

          <!-- 退役日期（条件显示） -->
          <view wx:if="{{currentItemDetail.showRetireDate}}" class="detail-item">
            <view class="detail-label">退役日期</view>
            <view class="detail-value">{{currentItemDetail.retireDateFormatted || '未设置'}}</view>
          </view>
        </view>

        <!-- 状态信息区域 -->
        <view class="detail-section">
          <view class="detail-section-title">状态信息</view>
          
          <view class="detail-row">
            <view class="detail-item detail-item-half">
              <view class="detail-label">物品状态</view>
              <view class="detail-value">{{currentItemDetail.statusLabel}}</view>
            </view>
            <view class="detail-item detail-item-half">
              <view class="detail-label">成本计算</view>
              <view class="detail-value">{{currentItemDetail.calculationMethodLabel}}</view>
            </view>
          </view>

          <!-- 已使用次数（条件显示且可编辑） -->
          <view wx:if="{{currentItemDetail.showUseTimes}}" class="detail-item">
            <view class="detail-label">已使用次数</view>
            <view class="detail-value detail-value-editable">
              <!-- 默认显示文字，点击后显示步进器 -->
              <view wx:if="{{!useTimesEditing}}" class="use-times-display-clickable" catchtap="startEditUseTimes">
                {{currentItemDetail.useTimes || 1}} 次
              </view>
              <!-- 编辑状态显示步进器 -->
              <view wx:else class="use-times-stepper-container" catchtap="stopPropagation">
                <t-stepper 
                  value="{{currentItemDetail.useTimes || 1}}" 
                  min="0" 
                  max="9999" 
                  theme="filled"
                  bind:change="onUseTimesChange"
                />
              </view>
            </view>
          </view>
        </view>

        <!-- 备注信息区域 -->
        <view wx:if="{{currentItemDetail.remarks}}" class="detail-section">
          <view class="detail-section-title">备注信息</view>
          <view class="detail-item">
            <view class="detail-value detail-value-remarks">{{currentItemDetail.remarks}}</view>
          </view>
        </view>

        <!-- 关联物品区域 -->
        <view class="detail-section">
          <view class="detail-section-title">
            关联物品
            <text wx:if="{{currentItemDetail.associatedItemsCount > 0}}" class="associated-total-value">
              ({{currentItemDetail.associatedItemsCount}}个) 总价值: ¥{{currentItemDetail.totalAssociatedValue}}
            </text>
          </view>
          
          <!-- 有关联物品时显示列表 -->
          <view wx:if="{{currentItemDetail.associatedItemsCount > 0}}" class="associated-items-list">
            <view wx:for="{{currentItemDetail.associatedItems}}" wx:key="id" class="associated-item" bindtap="editAssociatedItem" data-associated-item="{{item}}">
              <view class="associated-item-info">
                <view class="associated-item-name">{{item.name}}</view>
                <view class="associated-item-brand">{{item.brand || '无品牌'}}</view>
              </view>
              <view class="associated-item-right">
                <view class="associated-item-price">¥{{item.purchasePriceDisplay}}</view>
                <view class="associated-item-arrow">›</view>
              </view>
            </view>
          </view>
          
          <!-- 没有关联物品时显示提示 -->
          <view wx:else class="no-associated-items">
            <view class="no-associated-text">暂无关联物品</view>
          </view>
          
          <!-- 新增关联物品按钮 -->
          <view class="add-associated-button-container">
            <t-button 
              theme="light" 
              size="medium" 
              icon="add" 
              bindtap="addAssociatedItem"
              t-class="add-associated-button"
            >
              新增关联物品
            </t-button>
          </view>
        </view>

      </view>
    </scroll-view>

    <!-- 弹窗底部操作按钮 -->
    <view class="detail-modal-footer">
      <t-button theme="primary" size="large" bindtap="editItemFromDetail">
        编辑
      </t-button>
    </view>
  </view>
</view>