<!-- 顶部背景区域 -->
<view class="hero-background">
  <image class="hero-bg-image" src="/static/background/bg1.png" mode="aspectFill" />
  <view class="hero-content">
    <!-- <view class="hero-title">我的资产</view> -->
    <view class="hero-stats-row">
      <view class="hero-stat-item">
        <view class="hero-stat-label">物品金额</view>
        <view class="hero-stat-value value-amount">¥{{totalValue}}</view>
      </view>
      <view class="hero-stat-divider"></view>
      <view class="hero-stat-item">
        <view class="hero-stat-label">物品件数</view>
        <view class="hero-stat-value">{{totalCount}}</view>
      </view>
    </view>
    <view class="hero-stat-sub">
      最近7天 活跃
    </view>
  </view>
</view>

<view class="home-container">
  <view class="home-content">

    <!-- 分类筛选器和工具栏 -->
    <view class="category-section">
      <view class="category-header">
        <scroll-view 
          class="category-scroll" 
          scroll-x="true" 
          enable-flex="true"
          bindtouchstart="onCategoryTouchStart"
          bindtouchmove="onCategoryTouchMove"
          bindtouchend="onCategoryTouchEnd"
        >
          <view class="category-container">
            <view
              wx:for="{{categories}}"
              wx:key="item"
              data-item="{{item}}"
              bindtap="selectCategory"
              class="category-item {{selectedCategory === item ? 'category-active' : 'category-inactive'}}"
            >
              {{item}}
              <view wx:if="{{selectedCategory === item}}" class="category-indicator"></view>
            </view>
          </view>
        </scroll-view>
        
        <!-- 工具栏按钮 -->
        <view class="toolbar-buttons">
          <view class="toolbar-button" bindtap="toggleSearch">
            <view class="toolbar-icon search-icon-svg">
              <view class="svg-icon">
                <view class="search-circle"></view>
                <view class="search-handle"></view>
              </view>
            </view>
          </view>
          <view class="toolbar-button" bindtap="toggleViewMode">
            <view class="toolbar-icon view-mode-icon-svg">
              <view wx:if="{{viewMode === 'list'}}" class="svg-icon grid-icon">
                <view class="grid-dot"></view>
                <view class="grid-dot"></view>
                <view class="grid-dot"></view>
                <view class="grid-dot"></view>
              </view>
              <view wx:else class="svg-icon list-icon">
                <view class="list-line"></view>
                <view class="list-line"></view>
                <view class="list-line"></view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 搜索框（在分类筛选器下方） -->
      <view class="search-container {{showSearch ? 'search-expanded' : ''}}">
        <view class="search-input-wrapper">
          <input
            value="{{searchQuery}}"
            type="text"
            placeholder="搜索物品..."
            class="search-input"
            bindinput="onSearchInput"
          />
          <view 
            wx:if="{{searchQuery}}"
            class="search-clear-button"
            bindtap="clearSearch"
          >
            <text class="search-clear-icon">✕</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 物品列表标题 -->
    <view class="items-header">
      <view class="items-title">
        共{{filteredCount}}物品  ¥{{filteredValue}}
      </view>
      <view class="items-sort" bindtap="toggleSort">
        <text class="sort-icon">⇅</text>
        <text class="sort-text">{{sortOptions[currentSortIndex].label}}</text>
      </view>
    </view>

    <!-- 物品列表 -->
    <view class="items-list">
      <t-pull-down-refresh
        value="{{enable}}"
        bind:refresh="onRefresh"
        loadingTexts="{{['下拉刷新', '松手刷新', '正在刷新', '刷新完成']}}"
      >
        <!-- 空状态 -->
        <view wx:if="{{items.length === 0}}" class="empty-state">
          <text class="empty-icon">📁</text>
          <view class="empty-text">
            {{searchQuery ? '未找到匹配的物品' : '此分类暂无资产'}}
          </view>
        </view>

        <!-- 物品列表 -->
        <view wx:else class="items-container {{isSorting ? 'sorting' : ''}}">
          <!-- 列表模式 -->
          <view wx:if="{{viewMode === 'list'}}" class="list-view">
            <view
              wx:for="{{items}}"
              wx:key="id"
              bindtap="viewItem"
              data-item="{{item}}"
              class="item-card"
            >
              <view class="item-left">
                <view class="item-icon-container">
                  <image
                    src="{{item.iconPath}}"
                    alt="{{item.name}}"
                    class="item-icon"
                    mode="aspectFill"
                    lazy-load="{{true}}"
                    binderror="onImageError"
                    data-id="{{item.id}}"
                  />
                </view>
                <view class="item-info">
                  <view class="item-name">{{item.name}}</view>
                  <view class="item-meta">
                    <text class="item-category">{{item.category}}</text>
                    <text class="meta-dot">·</text>
                    <text class="item-date">{{item.purchaseDateFormatted}}</text>
                  </view>
                </view>
              </view>
              <view class="item-right">
                <view class="item-price">¥{{item.purchasePriceDisplay}}</view>
                <view class="item-value-label">{{item.avgCostDisplay}}</view>
              </view>
            </view>
          </view>

          <!-- 卡片模式 -->
          <view wx:else class="card-view">
            <view
              wx:for="{{items}}"
              wx:key="id"
              bindtap="viewItem"
              data-item="{{item}}"
              class="card-item"
            >
              <view class="card-icon-container">
                <image
                  src="{{item.iconPath}}"
                  alt="{{item.name}}"
                  class="card-icon"
                  mode="aspectFill"
                  lazy-load="{{true}}"
                  binderror="onImageError"
                  data-id="{{item.id}}"
                />
              </view>
              <view class="card-info">
                <view class="card-name">{{item.name}}</view>
                <view class="card-price">¥{{item.purchasePriceDisplay}}</view>
                <view class="card-avg-cost">{{item.avgCostDisplay}}</view>
                <view class="card-meta">
                  <text class="card-meta-category">{{item.category}}</text>
                  <text class="card-meta-dot">·</text>
                  <text class="card-meta-date">{{item.purchaseDateFormatted}}</text>
                </view>
              </view>
            </view>
          </view>
          
          <!-- 加载更多 -->
          <view wx:if="{{hasMoreData}}" class="load-more" bindtap="loadMore">
            <view wx:if="{{isLoadingMore}}" class="loading">
              <text>加载中...</text>
            </view>
            <view wx:else class="load-more-button">
              <text>点击加载更多</text>
            </view>
          </view>
        </view>
      </t-pull-down-refresh>
    </view>

    <!-- 底部间距 -->
    <view class="bottom-space"></view>
  </view>
</view>

<!-- 发布按钮 -->
<view class="fab-container">
  <t-button theme="primary" size="large" icon="add" shape="round" bindtap="goRelease">
    发布
  </t-button>
</view>

<t-message id="t-message" />

<!-- 物品详情抽屉 -->
<view wx:if="{{showDetailModal}}" class="drawer-overlay" bindtap="closeDetailModal">
  <!-- 半透明背景 -->
  <view class="drawer-background"></view>
  
  <!-- 抽屉内容 -->
  <view class="drawer-container {{drawerAnimated ? 'drawer-show' : ''}}" catchtap="stopPropagation">
    <!-- 拖拽手柄 -->
    <view class="drawer-handle">
      <view class="handle-bar"></view>
    </view>

    <!-- 抽屉头部 -->
    <view class="drawer-header">
      <view class="drawer-title">物品详情</view>
      <view class="drawer-actions">
        <view class="drawer-edit-btn" bindtap="editItemFromDetail">
          <text class="edit-icon">✎</text>
          <text class="edit-text">编辑</text>
        </view>
        <view class="drawer-close-btn" bindtap="closeDetailModal">
          <text class="close-icon">×</text>
        </view>
      </view>
    </view>

    <!-- 抽屉内容区域 -->
    <scroll-view class="drawer-content" scroll-y="true">
      <view wx:if="{{currentItemDetail}}" class="detail-content">

        <!-- 主要展示区域 -->
        <view class="main-display">
          <view class="main-icon-wrapper">
            <image src="{{currentItemDetail.iconPath}}" class="main-icon" mode="aspectFill" />
          </view>
          <view class="main-info">
            <view class="main-name">{{currentItemDetail.name}}</view>
            <view class="main-model">{{currentItemDetail.brand || '无品牌'}}</view>
            <view class="main-tags">
              <view class="tag-item category-tag">{{currentItemDetail.category}}</view>
              <view wx:if="{{currentItemDetail.entityTypeLabel}}" class="tag-item type-tag">{{currentItemDetail.entityTypeLabel}}</view>
            </view>
          </view>
        </view>

        <!-- 快速属性列表 -->
        <view class="stats-list">
          <view class="stat-row">
            <view class="stat-label">购入价值</view>
            <view class="stat-value">
              <text>¥ {{currentItemDetail.purchasePriceDisplay}}</text>
              <view wx:if="{{currentItemDetail.quantity > 1}}" class="stat-value-sub">
                单价 ¥{{currentItemDetail.purchasePriceUnitDisplay}} × {{currentItemDetail.quantity}}
              </view>
            </view>
          </view>
          <view class="stat-row">
            <view class="stat-label">数量</view>
            <view class="stat-value">{{currentItemDetail.quantity}}</view>
          </view>
          <view class="stat-row">
            <view class="stat-label">购入日期</view>
            <view class="stat-value">{{currentItemDetail.purchaseDateFormatted}}</view>
          </view>
          <view class="stat-row">
            <view class="stat-label">物品状态</view>
            <view class="stat-value">{{currentItemDetail.statusLabel}}</view>
          </view>
          <!-- 退役日期（条件显示） -->
          <view wx:if="{{currentItemDetail.showRetireDate}}" class="stat-row">
            <view class="stat-label">退役日期</view>
            <view class="stat-value">{{currentItemDetail.retireDateFormatted || '未设置'}}</view>
          </view>
          <!-- 成本计算方式 -->
          <view class="stat-row">
            <view class="stat-label">成本计算</view>
            <view class="stat-value">{{currentItemDetail.calculationMethodLabel}}</view>
          </view>
          <!-- 位置信息（条件显示） -->
          <view wx:if="{{currentItemDetail.location}}" class="stat-row">
            <view class="stat-label">位置</view>
            <view class="stat-value">{{currentItemDetail.location}}</view>
          </view>
          <!-- 描述（横跨2列） -->
          <view class="stat-row stat-row-full">
            <view class="stat-label">描述</view>
            <view class="stat-value stat-value-remarks">{{currentItemDetail.remarks || '无'}}</view>
          </view>
        </view>

        <!-- 已使用次数（条件显示且可编辑） -->
        <view wx:if="{{currentItemDetail.showUseTimes}}" class="usage-section">
          <view class="usage-label">已使用次数</view>
          <view class="usage-value-with-controls">
            <view class="usage-control" bindtap="decreaseUseTimes">
              <text class="control-icon">−</text>
            </view>
            <view class="usage-value">{{currentItemDetail.useTimes || 1}}</view>
            <view class="usage-control" bindtap="increaseUseTimes">
              <text class="control-icon">+</text>
            </view>
          </view>
        </view>

        <!-- 关联物品区域 -->
        <view class="accessories-section">
          <view class="section-header">
            <text class="section-title">关联服务与配件</text>
            <view class="add-button" bindtap="addAssociatedItem">
              <text class="add-icon">+</text>
              <text class="add-text">添加</text>
            </view>
          </view>
          
          <view class="accessories-list">
            <!-- 有关联物品时显示列表 -->
            <view wx:if="{{currentItemDetail.associatedItemsCount > 0}}">
              <view wx:for="{{currentItemDetail.associatedItems}}" wx:key="id" class="accessory-item" bindtap="editAssociatedItem" data-associated-item="{{item}}">
                <view class="accessory-left">
                  <view class="accessory-icon-container accessory-icon-{{item.entityType || 'physical'}}">
                    <text class="accessory-icon">{{item.entityTypeIcon}}</text>
                  </view>
                  <view class="accessory-info">
                    <view class="accessory-name">{{item.name}}</view>
                    <view wx:if="{{item.remarks}}" class="accessory-remarks">{{item.remarks}}</view>
                  </view>
                </view>
                <view class="accessory-right">
                  <view class="accessory-price">¥{{item.purchasePriceDisplay}}</view>
                  <text class="accessory-arrow">›</text>
                </view>
              </view>
            </view>
            
            <!-- 没有关联物品时显示提示 -->
            <view wx:else class="no-accessories">
              <text class="no-accessories-text">暂无关联项目</text>
            </view>
          </view>
        </view>


      </view>
    </scroll-view>
  </view>
</view>