<nav nav-type="search" />
<view class="home-container">
  <view class="home-content">
    <!-- 统计卡片 -->
    <view class="statistics-card">
      <view class="statistics-grid">
        <view class="statistics-item">
          <view class="statistics-value">{{totalCount}}</view>
          <view class="statistics-label">总物品数量</view>
        </view>
        <view class="statistics-item">
          <view class="statistics-value statistics-value-price">¥{{totalValue}}</view>
          <view class="statistics-label">总价值</view>
        </view>
      </view>
    </view>

    <!-- 搜索框和视图模式切换 -->
    <view class="search-container">
      <view class="search-input-wrapper">
        <input
          value="{{searchQuery}}"
          type="text"
          placeholder="搜索物品..."
          class="search-input"
          bindinput="onSearchInput"
        />
        <text class="search-icon">🔍</text>
        <!-- 清除按钮（仅在有搜索内容时显示） -->
        <view 
          wx:if="{{searchQuery}}"
          class="search-clear-button"
          bindtap="clearSearch"
        >
          <text class="search-clear-icon">✕</text>
        </view>
      </view>
      <!-- 视图模式切换按钮 -->
      <view 
        class="view-mode-toggle"
        bindtap="toggleViewMode"
      >
        <text class="view-mode-icon">{{viewMode === 'list' ? '☰' : '⊞'}}</text>
      </view>
    </view>

    <!-- 分类筛选 -->
    <scroll-view class="category-filter-scroll" scroll-x="true" enable-flex="true">
      <view class="category-filter-container">
        <view
          wx:for="{{categories}}"
          wx:key="item"
          data-item="{{item}}"
          bindtap="selectCategory"
          class="category-filter-item {{selectedCategory === item ? 'category-filter-item-selected' : 'category-filter-item-unselected'}}"
        >
          {{item}}
        </view>
      </view>
    </scroll-view>

    <!-- 物品列表 -->
    <view class="item-list-container">
      <t-pull-down-refresh
        value="{{enable}}"
        bind:refresh="onRefresh"
        loadingTexts="{{['下拉刷新', '松手刷新', '正在刷新', '刷新完成']}}"
      >
        <!-- 空状态组件 -->
        <view wx:if="{{items.length === 0}}" class="empty-state">
          <view class="empty-icon">📦</view>
          <view class="empty-text">
            {{searchQuery ? '未找到匹配的物品' : '暂无物品'}}
          </view>
          <view class="empty-hint">
            {{searchQuery ? '试试其他关键词或清除搜索' : '点击右下角按钮添加物品'}}
          </view>
        </view>

        <!-- 列表模式 -->
        <view wx:elif="{{viewMode === 'list'}}" class="list-mode">
          <view
            wx:for="{{items}}"
            wx:key="id"
            bindtap="viewItem"
            data-item="{{item}}"
            class="list-item"
          >
            <view class="list-item-content">
              <!-- 左侧：图片 + 信息 -->
              <view class="list-item-left">
                <view class="list-item-image">
                  <image
                    src="{{item.iconPath}}"
                    alt="{{item.name}}"
                    class="item-image"
                    mode="aspectFill"
                    lazy-load="{{true}}"
                    binderror="onImageError"
                    data-id="{{item.id}}"
                  />
                </view>
                <view class="list-item-info">
                  <!-- 物品名称（主要信息） -->
                  <view class="item-name">{{item.name}}</view>
                  
                  <!-- 品牌（次要信息） -->
                  <view class="item-brand">{{item.brand}}</view>
                  
                  <!-- 分类标签 -->
                  <view class="item-category-tag">
                    {{item.category}}
                  </view>
                  
                  <!-- 位置信息（条件渲染） -->
                  <view wx:if="{{item.location}}" class="item-location">
                    <text class="location-icon">📍</text>
                    <text>{{item.location}}</text>
                  </view>
                  
                  <!-- 关联物品提示（条件渲染） -->
                  <view wx:if="{{item.associatedItems && item.associatedItems.length > 0}}" class="item-associated">
                    <text class="associated-icon">🔗</text>
                    <text>关联 {{item.associatedItems.length}} 个物品</text>
                  </view>
                </view>
              </view>
              
              <!-- 右侧：价格 + 数量 -->
              <view class="list-item-right">
                <view class="item-price">¥{{item.purchasePriceDisplay}}</view>
                <view class="item-quantity">x{{item.quantity}}</view>
              </view>
            </view>
          </view>
          
          <!-- 加载更多指示器 -->
          <view wx:if="{{hasMoreData}}" class="load-more-container" bindtap="loadMore">
            <view wx:if="{{isLoadingMore}}" class="loading-indicator">
              <text class="loading-text">加载中...</text>
            </view>
            <view wx:else class="load-more-button">
              <text class="load-more-text">点击加载更多</text>
            </view>
          </view>
          
          <!-- 没有更多数据提示 -->
          <view wx:if="{{!hasMoreData && items.length > 0}}" class="no-more-data">
            <text class="no-more-text">已加载全部数据</text>
          </view>
        </view>

        <!-- 卡片模式 -->
        <view wx:else class="card-mode">
          <view
            wx:for="{{items}}"
            wx:key="id"
            bindtap="viewItem"
            data-item="{{item}}"
            class="card-item"
          >
            <!-- 图片在上 -->
            <view class="card-item-image">
              <image
                src="{{item.iconPath}}"
                alt="{{item.name}}"
                class="card-image"
                mode="aspectFill"
                lazy-load="{{true}}"
                binderror="onImageError"
                data-id="{{item.id}}"
              />
            </view>
            
            <!-- 信息在下 -->
            <view class="card-item-info">
              <!-- 物品名称 -->
              <view class="card-item-name">{{item.name}}</view>
              
              <!-- 价格 -->
              <view class="card-item-price">¥{{item.purchasePriceDisplay}}</view>
              
              <!-- 分类标签 -->
              <view class="card-item-category-tag">
                {{item.category}}
              </view>
            </view>
          </view>
          
          <!-- 加载更多指示器 -->
          <view wx:if="{{hasMoreData}}" class="load-more-container" bindtap="loadMore">
            <view wx:if="{{isLoadingMore}}" class="loading-indicator">
              <text class="loading-text">加载中...</text>
            </view>
            <view wx:else class="load-more-button">
              <text class="load-more-text">点击加载更多</text>
            </view>
          </view>
          
          <!-- 没有更多数据提示 -->
          <view wx:if="{{!hasMoreData && items.length > 0}}" class="no-more-data">
            <text class="no-more-text">已加载全部数据</text>
          </view>
        </view>
      </t-pull-down-refresh>
    </view>

