<t-navbar title="{{title}}" left-arrow />

<!-- 选择器遮罩层 -->
<view 
  wx:if="{{statusVisible || categoryVisible || purchaseDateVisible || retireDateVisible}}"
  class="picker-overlay"
  catchtap="hideAllPickers"
></view>

<view class="release-container">  
  <view class="info-edit box">
    <!-- 实体类型（仅主物品显示） -->
    <t-cell class="info-edit__cell" title="类型">
      <t-radio-group
        bind:change="onEntityTypeChange"
        borderless
        defaultValue="{{formData.entityType}}"
        options="{{entityTypes}}"
        slot="note"
        t-class="info-edit__gender"
        value="{{formData.entityType}}"
      />
    </t-cell>
    
    <t-cell class="info-edit__cell" title="物品名称">
      <t-input bind:change="onNameInput" borderless placeholder="请输入物品名称" slot="note" value="{{formData.name}}" />
    </t-cell>
    <t-cell class="info-edit__cell" title="品牌">
      <t-input bind:change="onBrandInput" borderless placeholder="请输入品牌名称" slot="note" value="{{formData.brand}}" />
    </t-cell>

    <!-- 图标选择（仅主物品显示） -->
    <t-cell wx:if="{{!isAssociated}}" class="info-edit__cell icon-selector" title="图标" bind:click="toggleIconSelector">
      <view class="icon-display" slot="note">
        <image wx:if="{{selectedIconInfo}}" src="{{selectedIconInfo.fullPath}}" class="selected-icon" />
        <text wx:else class="icon-placeholder">请选择图标</text>
        <t-icon name="chevron-down" class="arrow-icon {{iconSelectorVisible ? 'arrow-up' : ''}}" />
      </view>
    </t-cell>

    <!-- 图标候选列表（仅主物品显示） -->
    <view wx:if="{{iconSelectorVisible && !isAssociated}}" class="icon-candidates">
      <scroll-view scroll-x="true" class="icon-scroll">
        <view class="icon-list">
          <view wx:for="{{candidateIcons}}" wx:key="uniqueId" 
                class="icon-item {{formData.icon === item.uniqueId ? 'selected' : ''}}"
                bind:tap="selectIcon" data-icon="{{item.uniqueId}}">
            <image src="{{item.fullPath}}" class="icon-image" />
          </view>
          <view class="more-icon-btn" bind:tap="showAllIcons">
            <text>更多</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 物品类型（仅主物品显示） -->
    <t-cell wx:if="{{!isAssociated}}"  arrow bind:click="showPicker" data-mode="category" note="{{formData.category || '请选择物品类型'}}" title="物品类型" />

    <!-- 购入日期 -->
    <t-cell arrow bind:click="showPicker" data-mode="purchaseDate" note="{{formData.purchaseDate || '请选择购入日期'}}" title="购入日期" />
    
    <!-- 物品状态 -->
    <t-cell arrow bind:click="showPicker" data-mode="status" note="{{selectedStatusLabel || '请选择物品状态'}}" title="物品状态" />

    <!-- 退役日期 -->
    <t-cell arrow wx:if="{{selectedStatusLabel !== '使用中'}}" bind:click="showPicker" data-mode="retireDate" note="{{formData.retireDate || '请选择退役日期'}}" title="退役日期" />

    <!-- 数量 -->
    <t-cell class="info-edit__cell" title="数量">
      <t-input bind:change="onQuantityInput" borderless placeholder="填写数量" tips="{{quantityError ? '请输入正确的数量' : ''}}"
         slot="note"  align="right" type="number" t-class-tips="tips" value="{{formData.quantity}}"
      />
    </t-cell>

    <!-- 价格/单价 -->
    <t-cell class="info-edit__cell" title="{{quantityNotOne ? '单价' : '价格'}}">
      <view slot="note" class="price-input-wrapper">
        <t-input bind:change="onPurchasePriceInput" borderless placeholder="0.00" tips="{{priceError ? '请输入正确的价格' : ''}}"
           suffix="元" align="right" type="number" format="{{priceFormat}}" t-class-tips="tips" value="{{formData.purchasePrice}}"
        />
        <view wx:if="{{quantityNotOne && totalPriceDisplay}}" class="total-price-hint">
          <text>合计：¥{{totalPriceDisplay}}</text>
        </view>
      </view>
    </t-cell>

    <!-- 成本计算方式（仅主物品显示） -->
    <t-cell wx:if="{{!isAssociated}}" class="info-edit__cell" title="成本计算法">
      <t-radio-group
        bind:change="onCalculationMethodChange"
        borderless
        defaultValue="{{formData.averagePriceCalculationMethod}}"
        options="{{calculationMethods}}"
        slot="note"
        t-class="info-edit__gender"
        value="{{formData.averagePriceCalculationMethod}}"
      />
    </t-cell>

    <!-- 已使用次数（仅主物品且按使用次数计算时显示） -->
    <t-cell wx:if="{{!isAsociated && formData.averagePriceCalculationMethod === calculationMethods[1].value}}" class="info-edit__cell" title="已使用次数">
      <t-stepper bind:change="onUseTimesChange" slot="note" defaultValue="1" theme="filled" min="0" max="9999" value="{{formData.useTimes}}" />
    </t-cell>

    <view class="desc box">
      <view class="desc-label">描述</view>
      <!-- <t-textarea  slot="note" t-class="desc-class" t-class-textarea="placeholder-class" placeholder="分享你此刻的想法" maxlength="500" disableDefaultPadding="{{true}}" indicator /> -->
        <t-textarea
          value="{{formData.remarks}}"
          t-class="desc-class"
          t-class-textarea="placeholder-class"
          placeholder="请输入描述（可选）"
          disableDefaultPadding="{{true}}"
          bind:change="onRemarksInput"
          slot="note"
        />
    </view>
    
    <!-- 底部间距，防止被固定按钮遮挡 -->
    <view class="form-bottom-spacer"></view>
  </view>
  <view class="btngroup box">
    <!-- <t-button t-class="btn-class" theme="light" icon="file-copy" content="存草稿" size="large" bindtap="saveDraft"></t-button> -->
    <t-button t-class="btn-class" theme="primary" icon="upload" content="{{btnOptionContent}}" size="large" bindtap="saveItem"></t-button>
  </view>
</view>

<t-picker
  bind:cancel="hidePicker"
  bind:change="onPickerChange"
  bind:close="hidePicker"
  bind:pick="onAreaPick"
  cancelBtn="取消"
  confirmBtn="确认"
  data-mode="status"
  mode="status"
  title="选择物品状态"
  value="{{formData.status}}"
  visible="{{statusVisible}}"
>
  <t-picker-item options="{{statusTypes}}" />
</t-picker>

<t-picker
  bind:cancel="hidePicker"
  bind:change="onPickerChange"
  bind:close="hidePicker"
  bind:pick="onAreaPick"
  cancelBtn="取消"
  confirmBtn="确认"
  data-mode="category"
  mode="category"
  title="选择物品类别"
  value="{{formData.category}}"
  visible="{{categoryVisible}}"
>
  <t-picker-item options="{{categories}}" />
</t-picker>

<t-date-time-picker
  auto-close
  bind:cancel="hidePicker"
  bind:change="onPickerChange"
  cancelBtn="取消"
  confirmBtn="确认"
  data-mode="purchaseDate"
  defaultValue="{{today}}"
  format="YYYY-MM-DD"
  mode="date"
  popup-props="{{ { usingCustomNavbar: true } }}"
  end="{{today}}"
  title="选择购入日期"
  value="{{personInfo.purchaseDate}}"
  visible="{{purchaseDateVisible}}"
/>

<t-date-time-picker
  auto-close
  bind:cancel="hidePicker"
  bind:change="onPickerChange"
  cancelBtn="取消"
  confirmBtn="确认"
  data-mode="retireDate"
  defaultValue="{{today}}"
  format="YYYY-MM-DD"
  mode="date"
  popup-props="{{ { usingCustomNavbar: true } }}"
  end="{{today}}"
  title="选择退役日期"
  value="{{personInfo.retireDate}}"
  visible="{{retireDateVisible}}"
/>

<!-- 全部图标选择弹窗 -->
<t-popup bind:visible-change="onPopupVisibleChange" 
         placement="bottom" visible="{{allIconsDrawerVisible}}" 
         class="icon-popup">
  <view class="popup-header">
    <text class="popup-title">选择图标</text>
    <t-button theme="primary" size="small" bind:tap="confirmIconSelection">确认</t-button>
  </view>
  
  <t-tabs bind:change="onTabChange" value="{{currentTabIndex}}" 
          class="icon-tabs" scroll-threshold="4">
    <t-tab-panel wx:for="{{iconSeries}}" wx:key="seriesId" 
                 label="{{item.seriesName}}" value="{{index}}">
      <scroll-view scroll-y="true" class="tab-content-scroll">
        <view class="all-icons-grid">
          <view wx:for="{{item.icons}}" wx:for-item="icon" wx:key="uniqueId" 
                class="all-icon-item {{selectedIconInDrawer === icon.uniqueId ? 'selected' : ''}}"
                bind:tap="selectIconInDrawer" data-icon="{{icon.uniqueId}}">
            <image src="{{icon.fullPath}}" class="all-icon-image" />
            <text class="icon-name">{{icon.name}}</text>
          </view>
        </view>
      </scroll-view>
    </t-tab-panel>
  </t-tabs>
</t-popup>

<!-- 未登录提示弹窗 -->
<view wx:if="{{showLoginModal}}" class="login-modal-overlay" catchtap="onCloseLoginModal">
  <view class="login-modal" catchtap="stopPropagation">
    <view class="login-modal-icon">⚠️</view>
    <view class="login-modal-title">数据仅保存在本地</view>
    <view class="login-modal-desc">
      未登录状态下，数据保存在本机缓存中。
      如果清理微信缓存或更换设备，数据将无法找回。
    </view>
    <view class="login-modal-actions">
      <button class="modal-btn modal-btn-secondary" bindtap="onContinueWithoutLogin">继续（不登录）</button>
      <button class="modal-btn modal-btn-primary" bindtap="onGoLogin">去登录</button>
    </view>
  </view>
</view>